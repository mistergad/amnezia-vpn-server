APP_NAME=My VPN
ENVIRONMENT=development
BASE_URL=http://localhost:8000
SECRET_KEY=replace-with-at-least-32-random-characters
# Optional Fernet key. If omitted, it is derived from SECRET_KEY and SECRET_KEY must never change.
# ENCRYPTION_KEY=
DATABASE_URL=postgresql+psycopg://amnezia:change-db-password@db:5432/amnezia
TRUSTED_HOSTS=["localhost","127.0.0.1"]

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# mock for local development; yookassa for real payments.
PAYMENT_PROVIDER=mock
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# mock does not touch the network; native controls an existing AmneziaWG interface.
VPN_BACKEND=mock
AWG_INTERFACE=awg0
AWG_ENDPOINT=vpn.example.com:51820
AWG_SUBNET=10.8.1.0/24
AWG_DNS=1.1.1.1, 1.0.0.1
AWG_BINARY=awg
AWG_QUICK_BINARY=awg-quick
AWG_CONFIG_PATH=/etc/amnezia/amneziawg/awg0.conf
AWG_SAVE_CONFIG=true
# AWG2 supports five optional special junk packets. Current upstream defaults to I1 only.
# AWG_I1=<r 2><b 0x858000010001000000000669636c6f756403636f6d0000010001c00c000100010000105a00044d583737>
# AWG_I2=
# AWG_I3=
# AWG_I4=
# AWG_I5=
# Existing official container example (docker exec needs -i for preshared key via stdin):
# AWG_COMMAND_PREFIX=["sudo","-n","docker","exec","-i","amnezia-awg2"]

SESSION_HTTPS_ONLY=false
SUBSCRIPTION_RECONCILE_SECONDS=60
MAX_DEVICES_PER_SUBSCRIPTION=20
